# Optional: without a PAT the app opens the Azure DevOps token wizard.
# PAT or Entra ID access token. Generate one with: npm run token -- --org <org>
AZURE_DEVOPS_PAT=
# Recommended with an env PAT: restrict credentials to one organization.
AZURE_DEVOPS_ORG=
# Optional default PR URL to open automatically on startup.
AZURE_DEVOPS_PR=
# Optional persistent MCP credential; generated into the data volume when empty.
LEAFDOCK_MCP_TOKEN=
# Enable explicit MCP publish_note tool (can also be toggled in the web UI).
MCP_ALLOW_PUBLISH=false
# Optional local port, useful when another service already uses 3000.
LEAFDOCK_PORT=3000
# Optional pinned image for compose.registry.yaml (after first publication).
LEAFDOCK_IMAGE=ghcr.io/tichara1/leafdock:latest
